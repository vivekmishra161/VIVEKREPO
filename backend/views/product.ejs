    vehicles: "<%= t.vehicles %>",
    descriptionLine: "<%= t['High quality auto part with perfect fitting and durability.'] %>",
    brand: "<%= t.brand %>",
    category: "<%= t.category %>",
    partnumber: "<%= t.partnumber %>",
    stockstatus: "<%= t.stockstatus %>"
  };
</script>
<script>
document.addEventListener("DOMContentLoaded", () => {

  if (!product) return;

  // =====================
  // PRODUCT DESCRIPTION
  // =====================
  const descBox = document.getElementById("prodDescription");

descBox.innerHTML = `
  ${tLabels.Genuine} <b>${product.name}</b> ${tLabels.suitableFor}
  <b>${product.manufacturer}</b> ${tLabels.vehicles}.
  ${tLabels.descriptionLine}
`;


  // =====================
  // PRODUCT SPECIFICATIONS
  // =====================
  const specTable = document.getElementById("specTable");

specTable.innerHTML = `
  <tr>
    <td>${tLabels.brand}</td>
    <td>${product.manufacturer}</td>
  </tr>
  <tr>
    <td>${tLabels.category}</td>
    <td>${product.category}</td>
  </tr>
  <tr>
    <td>${tLabels.partnumber}</td>
    <td>${product.id}</td>
  </tr>
  <tr>
    <td>${tLabels.stockstatus}</td>
    <td>${product.stock}</td>
  </tr>
`;

});
</script>

</body>
</html>
