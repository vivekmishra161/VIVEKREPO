<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@300;400;600;700&display=swap" rel="stylesheet">

  <title>Product — AKC Auto Parts</title>
  <link rel="icon" type="image/png" href="/images/logo.png">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/mobile-ui.css">
  </div>

  <style>
/* ================================================================
   AKC AUTO PARTS — PRODUCT PAGE
   Theme: Obsidian · Charcoal · Champagne Gold
   Matches index.ejs dark theme exactly
   ================================================================ */

:root {
  --ink-0:    #08080a;
  --ink-1:    #0d0d10;
  --ink-2:    #111116;
  --ink-3:    #18181e;
  --ink-4:    #202028;
  --ink-5:    #2a2a34;
  --ink-6:    #36363f;
  --ink-7:    #48484f;

  --gold-1:   #b8941e;
  --gold-2:   #c9a84c;
  --gold-3:   #d4b86a;
  --gold-4:   #e2cc8c;
  --gold-5:   #f0e0b4;

  --text-1:   #f0f0ee;
  --text-2:   #c8c8c4;
  --text-3:   #8a8a84;
  --text-4:   #5a5a56;

  --white:    #ffffff;
  --success:  #1a9c5b;
  --danger:   #c0392b;

  --border:   var(--ink-5);
  --card:     var(--ink-3);
  --bg:       var(--ink-2);
  --muted:    var(--text-3);
  --accent:   var(--text-1);
  --accent-2: var(--gold-2);

  --r-sm: 10px;
  --r:    14px;
  --r-lg: 18px;
  --r-xl: 24px;

  --s1: 0 1px 4px rgba(0,0,0,.4);
  --s2: 0 2px 14px rgba(0,0,0,.5);
  --s3: 0 6px 28px rgba(0,0,0,.6);
  --s4: 0 12px 48px rgba(0,0,0,.7);
  --s-gold: 0 0 0 1px rgba(201,168,76,.2), 0 6px 24px rgba(0,0,0,.5);

  --transition: all 0.25s ease;
}

/* ── RESET & BASE ── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html, body { width: 100%; overflow-x: hidden; }

body {
  font-family: 'Nunito Sans', system-ui, sans-serif;
  background: var(--ink-2);
  color: var(--text-2);
  -webkit-font-smoothing: antialiased;
  line-height: 1.6;
  padding: 20px;
}

img { max-width: 100%; height: auto; display: block; }
a   { color: inherit; text-decoration: none; }

/* ── PAGE WRAPPER ── */
.page-wrapper {
  width: 100%; max-width: 100%;
  margin: 0 auto; padding: 0;
}

/* ── GLASS HEADER ── */
.glass-header {
  margin: 0 0 22px;
  padding: 14px 22px;
  border-radius: var(--r-lg);
  display: flex; align-items: center; justify-content: space-between;
  background: var(--ink-1);
  border: 1px solid var(--ink-5);
  box-shadow: var(--s2);
}

.header-bar {
  width: 100%;
  background: var(--ink-1);
  box-shadow: var(--s2);
  border-radius: var(--r-lg);
  margin-bottom: 32px;
  border: 1px solid var(--ink-5);
}

.header-left {
  display: flex; align-items: center; gap: 14px;
}
.header-left a {
  display: flex; align-items: center; gap: 12px;
  color: inherit; transition: opacity .2s;
}
.header-left a:hover { opacity: 0.8; }

.header-logo {
  height: 44px; width: auto;
  border-radius: 8px; object-fit: contain;
}

.brand-title {
  font-size: 18px; font-weight: 900;
  color: var(--gold-3);
  letter-spacing: 2px; text-transform: uppercase;
}

.header-right {
  font-size: 13px; color: var(--text-3); font-weight: 600;
}

/* ── LAYOUT ── */
.container {
  margin: 0;
  display: grid;
  grid-template-columns: 1fr 420px;
  gap: 28px;
  align-items: start;
}

/* ── MEDIA / IMAGE LEFT ── */
.media {
  background: transparent;
  display: flex; flex-direction: column; gap: 16px;
  animation: fadeInUp 0.5s ease;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(16px); }
  to   { opacity: 1; transform: translateY(0); }
}

.hero {
  width: 100%;
  background: var(--ink-3);
  border-radius: var(--r-lg); padding: 28px;
  box-shadow: var(--s2);
  display: flex; justify-content: center; align-items: center;
  min-height: 400px; position: relative; overflow: hidden;
  border: 1px solid var(--ink-5);
}

.hero img {
  width: 100%; max-width: 100%; max-height: 550px;
  height: auto; object-fit: contain;
  transition: transform 0.4s ease;
  cursor: zoom-in;
}

.hero:hover img { transform: scale(1.06); }

/* Thumbnails */
.thumbs {
  display: flex; gap: 10px; margin-top: 6px;
  flex-wrap: wrap; justify-content: flex-start;
}

.thumbs button {
  width: 80px; height: 64px;
  border-radius: 10px; border: 2px solid var(--ink-5);
  background: var(--ink-4);
  display: inline-flex; align-items: center; justify-content: center;
  padding: 6px; cursor: pointer; overflow: hidden;
  transition: border-color .2s;
}

.thumbs button:hover { border-color: var(--gold-2); }
.thumbs img { width: 100%; height: 100%; object-fit: cover; border-radius: 6px; }

/* ── META / DETAILS RIGHT ── */
.meta {
  background: var(--ink-3);
  border-radius: var(--r-lg); padding: 26px;
  box-shadow: var(--s2);
  display: flex; flex-direction: column; gap: 16px;
  height: fit-content; width: 100%;
  position: sticky; top: 20px;
  border: 1px solid var(--ink-5);
  animation: fadeInRight 0.5s ease;
}

@keyframes fadeInRight {
  from { opacity: 0; transform: translateX(16px); }
  to   { opacity: 1; transform: translateX(0); }
}

/* Brand Row */
.brand-row {
  display: flex; gap: 12px; align-items: center;
  padding-bottom: 14px;
  border-bottom: 1px solid var(--ink-5);
}

.brand-row img { height: 36px; width: auto; border-radius: 7px; object-fit: contain; }
.brand-row > div { display: flex; flex-direction: column; }

/* Title */
.title {
  font-size: 22px; font-weight: 800; margin: 0;
  letter-spacing: -0.01em; color: var(--text-1); line-height: 1.3;
}

.subline { color: var(--text-3); font-size: 13px; margin-top: 2px; font-weight: 600; }

/* Price */
.price-row {
  display: flex; gap: 12px; align-items: center;
  margin-top: 6px; flex-wrap: wrap;
}

.price {
  font-size: 30px; font-weight: 900;
  color: var(--gold-3); letter-spacing: -0.02em;
}

.old-price {
  text-decoration: line-through;
  color: var(--text-4); font-size: 16px; font-weight: 600;
}

/* Stock Badge */
.stock {
  padding: 7px 15px; border-radius: 50px;
  font-weight: 700; font-size: 11px; color: var(--white);
  text-transform: uppercase; letter-spacing: 0.8px;
  display: inline-block;
}
.stock.green  { background: #166534; border: 1px solid #22c55e; color: #86efac; }
.stock.orange { background: rgba(201,168,76,.18); border: 1px solid var(--gold-1); color: var(--gold-3); }
.stock.red    { background: rgba(192,57,43,.2); border: 1px solid var(--danger); color: #fca5a5; }

/* Delivery Box */
.delivery-box {
  background: rgba(26,156,91,.08);
  border: 1px solid rgba(26,156,91,.25);
  padding: 14px 16px; border-radius: 12px; margin-top: 6px;
}

.free-delivery { margin: 0 0 5px; font-weight: 800; color: #4ade80; font-size: 14px; }
.delivery-date { margin: 0; color: #86efac; font-size: 13px; font-weight: 600; }

/* Rating */
.rating {
  display: flex; gap: 10px; align-items: center;
  padding: 10px 0; border-bottom: 1px solid var(--ink-5);
}
.stars { display: flex; gap: 3px; }
.star  { font-size: 20px; color: var(--gold-3); cursor: pointer; opacity: 0.95; }
#ratingText { color: var(--text-3); font-size: 13px; font-weight: 600; }

/* Qty Row */
.qty-row {
  display: flex; gap: 12px; align-items: center;
  margin-top: 14px; flex-wrap: wrap;
}

.qty {
  display: flex; align-items: center;
  border-radius: 10px; overflow: hidden;
  border: 1.5px solid var(--ink-6);
  background: var(--ink-4);
}

.qty button {
  background: var(--ink-5); border: 0;
  padding: 12px 18px; cursor: pointer;
  font-weight: 700; font-size: 18px;
  color: var(--text-2); transition: background .18s;
  min-width: 46px;
}
.qty button:hover { background: var(--gold-2); color: var(--ink-1); }

.qty input {
  width: 58px; text-align: center; border: 0;
  border-left: 1px solid var(--ink-6);
  border-right: 1px solid var(--ink-6);
  padding: 12px 8px; font-size: 16px; font-weight: 700;
  color: var(--text-1); background: var(--ink-4);
  font-family: inherit;
}
.qty input:focus { outline: none; background: var(--ink-3); }

/* CTA Buttons */
.cta { display: flex; gap: 10px; margin-top: 14px; flex-wrap: wrap; }

.btn {
  padding: 13px 22px; border-radius: var(--r);
  cursor: pointer; border: 0;
  font-weight: 700; font-size: 14px;
  transition: var(--transition);
  display: inline-flex; align-items: center;
  justify-content: center; gap: 8px;
  min-height: 46px; text-decoration: none;
  font-family: inherit;
}

.btn.cart {
  background: var(--gold-2); color: var(--ink-0);
  box-shadow: 0 4px 16px rgba(201,168,76,.25); flex: 1;
}
.btn.cart:hover { background: var(--gold-3); box-shadow: 0 6px 20px rgba(201,168,76,.35); }

.btn.buy {
  background: var(--ink-5); color: var(--text-1);
  border: 1px solid var(--ink-6);
}
.btn.buy:hover { background: var(--ink-6); }

.btn.secondary {
  background: var(--ink-5); color: var(--text-2);
  border: 1px solid var(--ink-6);
}
.btn.secondary:hover { background: var(--ink-6); }

.btn.full { flex: 1; min-width: 200px; }

#backBtn {
  background: transparent !important;
  border: 1.5px dashed var(--ink-6) !important;
  color: var(--text-3) !important;
  padding: 10px 16px !important; font-weight: 700 !important;
}
#backBtn:hover {
  border-color: var(--gold-2) !important;
  color: var(--gold-3) !important;
}

.meta small { color: var(--text-3); font-size: 12px; line-height: 1.5; }

/* Share links */
.share-links { display: flex; gap: 8px; margin-top: 4px; }
.share-links a {
  display: flex; align-items: center; gap: 6px;
  padding: 7px 12px; border-radius: 8px;
  background: var(--ink-4); border: 1px solid var(--ink-6);
  font-size: 12px; font-weight: 600; color: var(--text-2);
  transition: border-color .2s, color .2s;
}
.share-links a:hover { border-color: var(--gold-2); color: var(--gold-3); }

/* ── DETAILS SECTION ── */
.details {
  margin-top: 20px;
  background: var(--ink-3);
  padding: 26px; border-radius: var(--r-lg);
  box-shadow: var(--s2); border: 1px solid var(--ink-5);
  animation: fadeInUp 0.6s ease;
}

.details h4 {
  margin: 0 0 14px; font-size: 18px; font-weight: 800;
  color: var(--text-1); padding-bottom: 10px;
  border-bottom: 2px solid var(--gold-1);
  display: inline-block;
}

.details p { line-height: 1.8; color: var(--text-3); font-size: 14px; margin-top: 10px; }

#prodDescription {
  color: var(--text-3); line-height: 1.8;
  font-size: 14px; margin-top: 6px; margin-bottom: 20px;
}

/* Specs Table */
.specs { width: 100%; border-collapse: collapse; margin-top: 14px; }
.specs tr { transition: background .18s; }
.specs tr:hover { background: var(--ink-4); }
.specs tr:first-child td { border-top: none; }

.specs td {
  padding: 12px 14px; border-top: 1px solid var(--ink-5);
  font-size: 14px; color: var(--text-3);
}
.specs td:first-child { font-weight: 700; color: var(--text-2); width: 40%; }

/* ── RELATED PRODUCTS ── */
.related {
  margin-top: 20px; display: flex; gap: 14px;
  overflow-x: auto; padding-bottom: 10px; scroll-behavior: smooth;
}

.related::-webkit-scrollbar { height: 6px; }
.related::-webkit-scrollbar-track { background: var(--ink-4); border-radius: 10px; }
.related::-webkit-scrollbar-thumb { background: var(--gold-1); border-radius: 10px; }

.rel-card {
  min-width: 178px; background: var(--ink-3);
  padding: 14px; border-radius: var(--r);
  box-shadow: var(--s1); display: flex;
  flex-direction: column; gap: 8px; align-items: center;
  border: 1px solid var(--ink-5);
  transition: box-shadow .25s, border-color .25s, transform .25s;
  cursor: pointer;
}
.rel-card:hover { box-shadow: var(--s-gold); transform: translateY(-3px); border-color: var(--gold-1); }

.rel-card img { width: 140px; height: 100px; object-fit: cover; border-radius: 9px; }
.rel-card h5 { font-size: 13px; font-weight: 700; text-align: center; color: var(--text-1); margin: 0; }
.rel-card .price { font-size: 15px; color: var(--gold-3); font-weight: 800; }
.rel-card button {
  margin-top: 6px; padding: 7px 14px; border-radius: 7px;
  border: 1px solid var(--ink-6); background: var(--ink-5);
  cursor: pointer; font-weight: 700; font-size: 12px;
  color: var(--text-2); transition: background .18s;
  font-family: inherit;
}
.rel-card button:hover { background: var(--gold-2); color: var(--ink-1); border-color: var(--gold-2); }

/* ── TOAST ── */
#toast, .toast {
  position: fixed; top: 50%; left: 50%;
  transform: translate(-50%, -50%) scale(0.82);
  padding: 16px 30px;
  background: var(--ink-3);
  color: var(--gold-3);
  border: 1px solid var(--gold-1);
  border-radius: var(--r);
  font-size: 16px; font-weight: 700; z-index: 9999;
  opacity: 0; pointer-events: none;
  transition: opacity .3s ease, transform .35s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: var(--s4); min-width: 240px; text-align: center;
}
#toast.show, .toast.show {
  opacity: 1; transform: translate(-50%, -50%) scale(1);
}

/* ── MODAL / SIGN-IN ── */
.modal-overlay {
  position: fixed; inset: 0;
  background: rgba(0,0,0,.75);
  display: none; align-items: center; justify-content: center;
  z-index: 9998; backdrop-filter: blur(6px);
}
.modal {
  background: var(--ink-3); padding: 28px;
  border-radius: var(--r-xl); width: 400px; max-width: 90%;
  box-shadow: var(--s4); text-align: center;
  border: 1px solid var(--ink-5);
  animation: modalFadeIn 0.3s ease;
}
@keyframes modalFadeIn {
  from { opacity: 0; transform: scale(0.9); }
  to   { opacity: 1; transform: scale(1); }
}
.modal h3 { margin: 0 0 10px; font-size: 20px; font-weight: 800; color: var(--text-1); }
.modal p  { color: var(--text-3); margin-bottom: 18px; line-height: 1.6; }
.modal .actions { display: flex; gap: 10px; margin-top: 18px; justify-content: center; }
.modal .actions .btn { flex: 1; }

/* ── REVIEW SECTION ── */
.review-section {
  margin-top: 24px; padding: 26px;
  background: var(--ink-3); border-radius: var(--r-lg);
  box-shadow: var(--s2); border: 1px solid var(--ink-5);
  animation: fadeInUp 0.7s ease;
}

.review-section h3 {
  margin: 0 0 18px; font-size: 20px; font-weight: 800;
  color: var(--text-1); padding-bottom: 10px;
  border-bottom: 2px solid var(--gold-1); display: inline-block;
}

.review-textarea, #reviewMessage {
  width: 100%; height: 96px; padding: 13px;
  font-size: 14px; font-family: 'Nunito Sans', sans-serif;
  border-radius: var(--r); border: 1.5px solid var(--ink-6);
  background: var(--ink-4); color: var(--text-1);
  transition: border-color .2s; resize: vertical; min-height: 80px;
}
.review-textarea::placeholder, #reviewMessage::placeholder { color: var(--text-4); }
.review-textarea:focus, #reviewMessage:focus {
  outline: none; border-color: var(--gold-2);
  box-shadow: 0 0 0 3px rgba(201,168,76,.1);
  background: var(--ink-3);
}

.review-submit-btn {
  padding: 11px 22px; border-radius: var(--r);
  background: var(--gold-2); color: var(--ink-0);
  border: none; cursor: pointer; font-weight: 700;
  font-size: 14px; transition: background .18s; margin-top: 10px;
  font-family: inherit;
}
.review-submit-btn:hover { background: var(--gold-3); }

.review-card, #reviewList > div {
  background: var(--ink-4); padding: 18px;
  margin-bottom: 14px; border-radius: var(--r);
  border: 1px solid var(--ink-5);
  transition: border-color .2s;
}
.review-card:hover, #reviewList > div:hover { border-color: var(--gold-1); }

/* override JS-injected inline styles for review cards */
#reviewList > div { background: var(--ink-4) !important; }

.review-user  { font-weight: 800; font-size: 15px; color: var(--text-1); margin-bottom: 4px; }
.review-message { margin: 8px 0; color: var(--text-3); line-height: 1.7; font-size: 14px; }
.review-date  { font-size: 11px; color: var(--text-4); font-style: italic; }
.review-stars { color: var(--gold-3); font-size: 17px; margin-bottom: 6px; }

#reviewRating {
  padding: 9px 13px; font-size: 14px; border-radius: 9px;
  border: 1.5px solid var(--ink-6); cursor: pointer;
  background: var(--ink-4); color: var(--text-1);
  font-weight: 600; margin-left: 10px; font-family: inherit;
  transition: border-color .2s;
}
#reviewRating:focus  { outline: none; border-color: var(--gold-2); }
#reviewRating option { background: var(--ink-3); color: var(--text-1); }

.star-input { font-size: 24px; cursor: pointer; transition: transform 0.2s ease; display: inline-block; }
.star-input:hover { transform: scale(1.2); color: var(--gold-3); }

/* ── POPUP OVERLAY ── */
.popup-overlay {
  position: fixed; inset: 0;
  background: rgba(0,0,0,.7); display: none;
  justify-content: center; align-items: center;
  z-index: 999; backdrop-filter: blur(5px);
}
.popup-box {
  background: var(--ink-3); padding: 24px; width: 380px;
  max-width: 90%; border-radius: var(--r-xl);
  box-shadow: var(--s4); text-align: center;
  border: 1px solid var(--ink-5);
}
.popup-box textarea {
  width: 100%; height: 96px; padding: 12px;
  border: 1.5px solid var(--ink-6); border-radius: 9px;
  background: var(--ink-4); color: var(--text-1);
  font-family: 'Nunito Sans', sans-serif; transition: border-color .2s;
  resize: vertical;
}
.popup-box textarea:focus {
  outline: none; border-color: var(--gold-2);
  box-shadow: 0 0 0 3px rgba(201,168,76,.1);
}
.popup-actions { display: flex; gap: 10px; margin-top: 14px; }

/* ── DOT INDICATORS ── */
.dot-indicators { display: flex; gap: 8px; justify-content: center; margin-top: 10px; }
.dot {
  width: 10px; height: 10px; border-radius: 999px;
  background: var(--ink-6); cursor: pointer; transition: background .15s, transform .15s;
}
.dot.active { background: var(--gold-2); transform: scale(1.15); }

/* ── DISCOUNT BADGE ── */
.discount-badge {
  display: inline-block; padding: 5px 11px;
  background: rgba(26,156,91,.15); border: 1px solid rgba(26,156,91,.3);
  color: #4ade80; font-size: 11px; font-weight: 800;
  border-radius: 6px; letter-spacing: 0.5px; text-transform: uppercase;
}

/* ── RESPONSIVE ── */
@media (max-width: 1200px) {
  .container { max-width: 100%; padding: 0; gap: 22px; }
  .meta { position: relative; top: 0; }
  .title { font-size: 20px; }
  .price { font-size: 26px; }
}

@media (max-width: 1024px) {
  body { padding: 15px; }
  .container { grid-template-columns: 1fr !important; gap: 18px; }
  .meta { max-width: 100%; position: static; }
  .hero { min-height: 340px; }
  .details, .review-section { padding: 22px; }
}

@media (max-width: 768px) {
  body { padding: 12px 10px; }
  .glass-header { padding: 11px 14px; flex-wrap: wrap; gap: 8px; border-radius: 13px; }
  .header-logo { height: 34px; }
  .brand-title { font-size: 15px; }
  .header-right { display: none; }
  .container { gap: 16px; }
  .hero { padding: 18px; min-height: 270px; border-radius: 13px; }
  .hero img { max-height: 340px; }
  .thumbs { gap: 7px; }
  .thumbs button { width: 68px; height: 54px; }
  .meta { padding: 18px; border-radius: 13px; }
  .title { font-size: 18px; }
  .price { font-size: 22px; }
  .old-price { font-size: 15px; }
  .stock { padding: 5px 11px; font-size: 10px; }
  .delivery-box { padding: 11px 13px; }
  .rating { flex-wrap: wrap; gap: 7px; }
  .star { font-size: 18px; }
  .qty-row { flex-wrap: wrap; gap: 9px; }
  .qty { width: 100%; justify-content: center; }
  .qty input { width: 68px; }
  .qty button { padding: 10px 13px; }
  .cta { flex-direction: column; gap: 9px; }
  .btn { width: 100%; }
  .details { padding: 18px; margin-top: 14px; }
  .details h4 { font-size: 17px; }
  .specs td { padding: 11px; font-size: 13px; }
  .related { gap: 11px; }
  .rel-card { min-width: 155px; padding: 11px; }
  .rel-card img { width: 118px; height: 88px; }
  .review-section { padding: 18px; margin-top: 16px; }
  .review-section h3 { font-size: 18px; }
  .review-textarea, #reviewMessage { height: 86px; }
