<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Your Cart - AKC Auto Parts</title>
  <link rel="icon" type="image/png" href="/images/logo.png">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/mobile-ui.css">

  <!-- Google Font -->
 <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@300;400;600;700&display=swap" rel="stylesheet">


<style>
/* ================================================================
   AKC AUTO PARTS — CART PAGE
   Theme: Obsidian · Charcoal · Champagne Gold
   Matches index.ejs & product.ejs dark theme exactly
   ================================================================ */

:root {
  --ink-0:  #08080a;
  --ink-1:  #0d0d10;
  --ink-2:  #111116;
  --ink-3:  #18181e;
  --ink-4:  #202028;
  --ink-5:  #2a2a34;
  --ink-6:  #36363f;
  --ink-7:  #48484f;

  --gold-1: #b8941e;
  --gold-2: #c9a84c;
  --gold-3: #d4b86a;
  --gold-4: #e2cc8c;

  --text-1: #f0f0ee;
  --text-2: #c8c8c4;
  --text-3: #8a8a84;
  --text-4: #5a5a56;

  --white:   #ffffff;
  --danger:  #c0392b;
  --success: #1a9c5b;

  --r-sm: 9px;
  --r:    13px;
  --r-lg: 18px;
  --r-xl: 24px;

  --s1: 0 1px 4px rgba(0,0,0,.4);
  --s2: 0 2px 14px rgba(0,0,0,.5);
  --s3: 0 6px 28px rgba(0,0,0,.6);
  --s4: 0 12px 48px rgba(0,0,0,.7);
  --s-gold: 0 0 0 1px rgba(201,168,76,.2), 0 6px 24px rgba(0,0,0,.5);
}

/* ── RESET ── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { font-size: 16px; scroll-behavior: smooth; }
html, body { width: 100%; max-width: 100%; overflow-x: hidden; }
body * { max-width: 100%; }

/* ── BODY ── */
body {
  font-family: 'Nunito Sans', system-ui, sans-serif;
  background: var(--ink-2);
  color: var(--text-2);
  padding: 20px;
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
}

/* ── HEADER ── */
header {
  width: 100%; max-width: 1150px;
  margin: 0 auto 20px;
  background: var(--ink-1);
  border-radius: var(--r-lg); padding: 12px 20px;
  display: flex; align-items: center; gap: 14px;
  box-shadow: var(--s2);
  border: 1px solid var(--ink-5);
  position: relative;
}

/* gold accent bottom line */
header::after {
  content: '';
  position: absolute; bottom: 0; left: 0; right: 0; height: 1px;
  border-radius: 0 0 var(--r-lg) var(--r-lg);
  background: linear-gradient(90deg, transparent 5%, var(--gold-1) 35%, var(--gold-4) 55%, var(--gold-1) 75%, transparent 95%);
  opacity: 0.5;
}

header a {
  display: flex; align-items: center; gap: 12px;
  text-decoration: none; color: inherit;
}

header img {
  height: 42px; max-width: 120px; object-fit: contain; cursor: pointer;
}

header > a > div {
  font-weight: 900; font-size: clamp(14px, 3vw, 17px);
  cursor: pointer; color: var(--gold-3);
  text-transform: uppercase; letter-spacing: 2px;
}

header > div:last-child {
  margin-left: auto; color: var(--text-3);
  font-size: clamp(11px, 2.5vw, 13px); font-weight: 600;
}

/* ── CART BOX ── */
.box {
  width: 100%; max-width: 1000px;
  margin: 0 auto;
  background: var(--ink-3);
  padding: 32px 28px;
  border-radius: var(--r-xl);
  box-shadow: var(--s3);
  border: 1px solid var(--ink-5);
  animation: fadeUp 0.5s ease;
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20px); }
  to   { opacity: 1; transform: translateY(0); }
}

h2 {
  text-align: center;
  font-size: clamp(20px, 5vw, 28px);
  font-weight: 800; margin-bottom: 28px;
  color: var(--gold-3);
  letter-spacing: 0.5px;
}

/* ── TABLE — DESKTOP ── */
table {
  width: 100%; border-collapse: separate;
  border-spacing: 0 12px; margin-bottom: 18px;
}

thead { position: sticky; top: 0; z-index: 10; }

th {
  background: var(--ink-1);
  color: var(--gold-3);
  padding: 13px 16px;
  border-radius: var(--r-sm);
  font-size: clamp(11px, 2.5vw, 13px);
  text-transform: uppercase; letter-spacing: 1px;
  font-weight: 800; text-align: center;
  border-bottom: 1px solid var(--gold-1);
}

tbody tr { transition: transform .2s; }
tbody tr:hover { transform: translateY(-2px); }

td {
  background: var(--ink-4);
  padding: 16px 14px;
  font-size: clamp(13px, 2.8vw, 14px);
  text-align: center; vertical-align: middle; border: none;
  color: var(--text-2);
  transition: background .2s;
}

tbody tr:hover td { background: var(--ink-5); }

tbody tr td:first-child { border-top-left-radius: var(--r); border-bottom-left-radius: var(--r); }
tbody tr td:last-child  { border-top-right-radius: var(--r); border-bottom-right-radius: var(--r); }

/* ── QTY INPUT ── */
input[type="number"] {
  width: 68px; padding: 9px 7px;
  border-radius: var(--r-sm);
  border: 1.5px solid var(--ink-6);
  text-align: center;
  font-size: clamp(13px, 2.8vw, 14px); font-weight: 600;
  transition: border-color .2s;
  background: var(--ink-3); color: var(--text-1);
  font-family: inherit;
}

input[type="number"]:focus {
  outline: none; border-color: var(--gold-2);
  box-shadow: 0 0 0 3px rgba(201,168,76,.12);
}

input[type="number"]::-webkit-inner-spin-button,
input[type="number"]::-webkit-outer-spin-button { opacity: 1; }

/* ── BUTTONS ── */
.btn {
  background: var(--ink-5);
  color: var(--text-1);
  border: 1px solid var(--ink-6);
  padding: 12px 22px; border-radius: var(--r);
  cursor: pointer; font-weight: 700;
  font-size: clamp(12px, 3vw, 14px);
  transition: background .2s, border-color .2s;
  text-transform: uppercase; letter-spacing: 0.5px;
  font-family: inherit;
}

.btn:hover { background: var(--ink-6); }
.btn:active { background: var(--ink-4); }
.btn:disabled { opacity: 0.4; cursor: not-allowed; pointer-events: none; }

/* Primary (checkout) button — gold */
#checkoutBtn, .btn:not(.secondary) {
  background: var(--gold-2); color: var(--ink-0);
  border: none; font-weight: 800;
  box-shadow: 0 4px 16px rgba(201,168,76,.25);
}
#checkoutBtn:hover, .btn:not(.secondary):hover {
  background: var(--gold-3);
  box-shadow: 0 6px 22px rgba(201,168,76,.35);
}

/* Secondary (continue shopping / remove) — dark outline */
.btn.secondary {
  background: transparent; color: var(--text-2);
  border: 1.5px solid var(--ink-6);
  box-shadow: none;
}
.btn.secondary:hover { background: var(--ink-4); border-color: var(--ink-7); }

/* ── TOTAL BOX ── */
.total-box {
  width: 100%; margin-top: 26px;
  background: var(--ink-4);
  border-radius: var(--r-lg); padding: 22px 26px;
  text-align: right;
  font-size: clamp(18px, 5vw, 24px); font-weight: 800;
  color: var(--text-2);
  box-shadow: var(--s1);
  border: 1px solid var(--ink-5);
}

.total-box span { color: var(--gold-3); }

/* ── BUTTON CONTAINER ── */
.button-container {
  width: 100%; margin-top: 22px;
  display: flex; gap: 11px; justify-content: center; flex-wrap: wrap;
}

/* ── EMPTY CART ── */
.empty-msg {
  text-align: center; font-size: clamp(15px, 4vw, 17px);
  padding: 38px 18px; color: var(--text-3); font-weight: 600;
}

/* ── FLOAT ANIMATION (removed — keeping only subtle) ── */
.btn-float { /* no float animation — keeps things premium */ }

/* ── POPUP OVERLAY ── */
.popup-overlay {
  position: fixed; inset: 0;
  background: rgba(0,0,0,.72);
  backdrop-filter: blur(7px);
  display: none; justify-content: center; align-items: center;
  z-index: 9999; padding: 20px;
}

.popup-box {
  width: 100%; max-width: 400px;
  background: var(--ink-3); padding: 30px 34px;
  border-radius: var(--r-xl); text-align: center;
  box-shadow: var(--s4);
  border: 1px solid var(--ink-5);
  animation: popIn .28s ease;
}

@keyframes popIn {
  from { transform: scale(.86); opacity: 0; }
  to   { transform: scale(1);   opacity: 1; }
}

.popup-box h3 {
  margin-bottom: 11px;
  font-size: clamp(17px, 4vw, 21px); font-weight: 800;
  color: var(--text-1);
}

.popup-box p {
  color: var(--text-3); font-size: clamp(13px, 3vw, 15px);
  margin-bottom: 22px; line-height: 1.6;
}

.popup-actions {
  display: flex; gap: 11px; justify-content: center; flex-wrap: wrap;
}

.popup-btn {
  flex: 1; min-width: 100px;
  padding: 12px 20px; border-radius: var(--r);
  font-weight: 700; font-size: clamp(12px, 3vw, 14px);
  cursor: pointer; border: none; transition: background .18s;
  text-transform: uppercase; letter-spacing: 0.5px; font-family: inherit;
}

.popup-btn.signin {
  background: var(--gold-2); color: var(--ink-0);
  box-shadow: 0 4px 14px rgba(201,168,76,.25);
}
.popup-btn.signin:hover { background: var(--gold-3); }

.popup-btn.cancel {
  background: var(--ink-5); color: var(--text-2);
  border: 1px solid var(--ink-6);
}
.popup-btn.cancel:hover { background: var(--ink-6); }

/* ── LANGUAGE SELECTOR ── */
.lang-select { position: relative; display: inline-block; }

.lang-select select {
  appearance: none; -webkit-appearance: none;
  background: var(--ink-4);
  border: 1.5px solid var(--gold-1);
  border-radius: 9px;
  padding: 7px 34px 7px 11px;
  font-size: clamp(11px, 2.5vw, 13px); font-weight: 600;
  color: var(--gold-3); cursor: pointer; outline: none;
  transition: border-color .2s; font-family: inherit;
}

.lang-select select:hover,
.lang-select select:focus { border-color: var(--gold-2); }
.lang-select select option { background: var(--ink-3); color: var(--text-1); }

.lang-select::after {
  content: "🌐"; position: absolute;
  right: 9px; top: 50%; transform: translateY(-50%);
  font-size: 14px; pointer-events: none;
}

/* ── SELECTION COLOR ── */
::selection       { background: var(--gold-2); color: var(--ink-0); }
::-moz-selection  { background: var(--gold-2); color: var(--ink-0); }

/* ── DISCOUNT BADGE ── */
.discount-tag {
  color: #4ade80; font-size: 11px; font-weight: 700;
  background: rgba(26,156,91,.12);
  border: 1px solid rgba(26,156,91,.25);
  border-radius: 5px; padding: 2px 7px;
  display: inline-block; margin-top: 4px;
}

/* ── TABLE SCROLLBAR ── */
table::-webkit-scrollbar { height: 6px; }
table::-webkit-scrollbar-track { background: var(--ink-4); border-radius: 10px; }
table::-webkit-scrollbar-thumb { background: var(--gold-1); border-radius: 10px; }

/* ════════════════════════════════════
   RESPONSIVE
   ════════════════════════════════════ */

/* Large desktop */
@media (min-width: 1200px) {
  .box { padding: 38px 34px; }
  th, td { padding: 15px 18px; }
}

/* Tablet */
@media (min-width: 768px) and (max-width: 1199px) {
  body { padding: 16px 14px; }
  header { padding: 11px 16px; }
  .box { padding: 26px 22px; }
  table { border-spacing: 0 10px; }
  th { padding: 11px 13px; }
  td { padding: 14px 12px; }
  input[type="number"] { width: 62px; }
}

/* Large mobile / small tablet */
@media (min-width: 481px) and (max-width: 767px) {
  body { padding: 14px 11px; }
  header { flex-wrap: wrap; padding: 11px 14px; gap: 9px; }
  header img { height: 36px; }
  .box { padding: 22px 18px; border-radius: 16px; }
  table { display: block; overflow-x: auto; white-space: nowrap; border-spacing: 0 9px; -webkit-overflow-scrolling: touch; }
  thead, tbody, tr { display: table; width: 100%; table-layout: fixed; }
  th { padding: 11px 9px; }
  td { padding: 13px 9px; }
  input[type="number"] { width: 58px; padding: 7px 5px; }
  .btn { padding: 10px 16px; }
  .total-box { padding: 18px 20px; }
}

/* Mobile — card layout */
@media (max-width: 480px) {
  body { padding: 11px 9px; }

  header { flex-direction: column; padding: 11px 14px; gap: 9px; text-align: center; }
  header img { height: 33px; }
  header > div:last-child { margin-left: 0; display: none; }

  .box { padding: 18px 13px; border-radius: 14px; }

  table, thead, tbody, th, td, tr { display: block; }
  thead tr { position: absolute; top: -9999px; left: -9999px; }

  tbody tr {
    margin-bottom: 16px; border-radius: 13px;
    box-shadow: var(--s2); padding: 15px;
    background: var(--ink-4); border: 1px solid var(--ink-5);
  }
  tbody tr:hover { transform: none; }

  td {
    background: transparent; border: none;
    position: relative; padding: 11px 11px 11px 45%;
    text-align: right; white-space: normal; color: var(--text-2);
  }

  td::before {
    content: attr(data-label);
    position: absolute; left: 11px; width: 40%; padding-right: 9px;
    text-align: left; font-weight: 800; color: var(--gold-3);
    text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px;
  }

  td:nth-of-type(1)::before { content: "Product"; }
  td:nth-of-type(2)::before { content: "Quantity"; }
  td:nth-of-type(3)::before { content: "Subtotal"; }
  td:nth-of-type(4)::before { content: "Action"; }

  tbody tr:hover td { background: transparent; box-shadow: none; }

  input[type="number"] { width: 100%; max-width: 118px; padding: 9px 7px; }

  .btn { width: 100%; padding: 11px 18px; border-radius: 10px; }
  .total-box { padding: 17px 18px; text-align: center; }
  .button-container { flex-direction: column; gap: 9px; }
  .btn.secondary, #checkoutBtn { width: 100%; }
  .popup-box { padding: 22px 26px; border-radius: 16px; }
  .popup-actions { flex-direction: column; }
  .popup-btn { width: 100%; }
}

/* Extra small */
@media (max-width: 360px) {
  body { padding: 9px 7px; }
  header { padding: 9px 11px; border-radius: 11px; }
  header img { height: 30px; }
  .box { padding: 16px 11px; border-radius: 12px; }
  h2 { margin-bottom: 18px; }
  tbody tr { padding: 13px 11px; margin-bottom: 13px; }
  td { padding: 9px 9px 9px 42%; font-size: 12px; }
  td::before { font-size: 10px; }
  input[type="number"] { padding: 7px 5px; }
  .btn { padding: 10px 14px; font-size: 12px; }
  .total-box { padding: 14px 16px; border-radius: 11px; }
  .popup-box { padding: 18px 20px; }
}

/* Extra extra small */
@media (max-width: 320px) {
  body { padding: 7px 5px; }
  header img { height: 28px; }
  .box { padding: 13px 9px; }
  tbody tr { padding: 11px 9px; }
  td { padding: 7px 7px 7px 40%; }
}
</style>


</head>

<body>
<header style="max-width:1150px;margin:0 auto 18px;padding:6px 0;display:flex;align-items:center;gap:12px;">

  <!-- LOGO CLICK → HOME -->
  <a href="/" style="display:flex;align-items:center;gap:12px;text-decoration:none;color:inherit;">
    
    <img 
      src="/images/logo.png"
      alt="AKC AUTO PARTS"
      style="height:38px;cursor:pointer;"
    >

    <div style="font-weight:800;font-size:16px;cursor:pointer;">
      AKC AUTO PARTS
    </div>

  </a>

  <div style="margin-left:auto;color:var(--muted);font-size:14px;">
    <%= t.partsFor %>
  </div>

</header>

<div class="box">

  <table>
    <thead>
      <tr>
        <th><%= t.product %></th>
        <th><%= t.qty %></th>
        <th><%= t.subtotal %></th>
        <th><%= t.action %></th>
      </tr>
    </thead>
    <tbody id="cartRows"></tbody>
  </table>

  <div class="total-box">
    <%= t.grandTotal %>: ₹<span id="grandTotal">0</span>
  </div>

  <div style="margin-top:25px; display:flex; gap:10px; justify-content:center;">
    <button class="btn secondary btn-float" onclick="window.location.href='/'">
      ⬅ <%= t.continueShopping %>
    </button>
    <button
  id="checkoutBtn"
  class="btn btn-float"
  onclick="handleCheckout()"
>
  <%= t.checkout %> →
</button>

  </div>
</div>


<script>

const t = <%- JSON.stringify(t) %>;

const LS_CART_KEY = "akc_cart_v1";

function loadCart() {
  return JSON.parse(localStorage.getItem(LS_CART_KEY)) || [];
}

function saveCart(cart) {
  localStorage.setItem(LS_CART_KEY, JSON.stringify(cart));
}

function renderCart() {
  const cart = loadCart();
  const tbody = document.getElementById("cartRows");

  tbody.innerHTML = "";

  let grandTotal = 0;

  if (cart.length === 0) {
    tbody.innerHTML = `
      <tr>
        <td colspan="4" class="empty-msg">Your cart is empty</td>
      </tr>
    `;
    document.getElementById("grandTotal").innerText =
         Number(grandTotal).toFixed(2);


    return;
  }

  cart.forEach(item => {
     const price = Number(item.price || 0);
     const subtotal = price * Number(item.qty || 1);

    grandTotal += Math.round(subtotal * 100) / 100;


    const tr = document.createElement("tr");

    tr.innerHTML = `
      <td>${item.name}</td>

      <td>
        <input type="number" min="1" value="${item.qty}"
          onchange="updateQty('${item.id}', this.value)">
      </td>

      <td>
        ₹${subtotal.toFixed(2)}
        ${
          item.discount > 0
            ? `<div class="discount-tag">
                ${item.discount}% OFF applied
              </div>`
            : ""
        }
      </td>

      <td>
        <button class="btn secondary" onclick="removeItem('${item.id}')">
          Remove
        </button>
      </td>
    `;

    tbody.appendChild(tr);
  });

  document.getElementById("grandTotal").innerText = grandTotal;
  updateCheckoutButton();
}
function updateCheckoutButton() {
  const cart = loadCart();
  const btn = document.getElementById("checkoutBtn");

  if (cart.length > 0) {
    btn.disabled = false;
    btn.style.opacity = "1";
    btn.style.cursor = "pointer";
  } else {
    btn.disabled = true;
    btn.style.opacity = "0.5";
    btn.style.cursor = "not-allowed";
  }
}

function updateQty(id, qty) {
  let cart = loadCart();
  qty = Number(qty);

  cart = cart.map(item =>
    item.id === id ? { ...item, qty } : item
  );

  saveCart(cart);
  renderCart();
  updateCheckoutButton();
}


function removeItem(id) {
  let cart = loadCart().filter(item => item.id !== id);
  saveCart(cart);
  renderCart();
  updateCheckoutButton();
}

renderCart();
</script>
<script>
  const isLoggedIn = <%= user ? "true" : "false" %>;

  function handleCheckout() {
    const cart = JSON.parse(localStorage.getItem("akc_cart_v1")) || [];

    if (cart.length === 0) {
      alert("Cart is empty");
      return;
    }

    // ❌ not logged in
    if (!isLoggedIn) {
      document.getElementById("signinPopup").style.display = "flex";
      return;
    }

    // ✅ logged in
    window.location.href = "/registration";
  }

  function goToSignin() {
    window.location.href = "/signin";
  }

  function closePopup() {
    document.getElementById("signinPopup").style.display = "none";
  }
</script>


<!-- ---------------- SIGN-IN POPUP HTML ---------------- -->
<div id="signinPopup" class="popup-overlay">
  <div class="popup-box">
    <h3><%= t.pleaseSignIn %></h3>
    <p><%= t.mustSignInCheckout %></p>

    <div class="popup-actions">
      <button class="popup-btn signin" onclick="goToSignin()"><%= t.signIn %></button>
      <button class="popup-btn cancel" onclick="closePopup()"><%= t.no %></button>
    </div>
  </div>
</div>

</body>
</html>
