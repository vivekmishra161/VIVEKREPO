<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MY ORDERS</title>
<link rel="icon" type="image/png" href="/images/logo.png">
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/mobile-ui.css">
<link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@300;400;600;700;800;900&display=swap" rel="stylesheet">

<style>
/* ============================================
   AKC AUTO PARTS — MY ORDERS DARK THEME
   Palette: Obsidian · Charcoal · Champagne Gold
============================================ */

*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  max-width: 100%;
}

html {
  font-size: 16px;
  scroll-behavior: smooth;
}

html, body {
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
}

:root {
  --ink-0:    #08080a;
  --ink-1:    #0d0d10;
  --ink-2:    #111116;
  --ink-3:    #18181e;
  --ink-4:    #202028;
  --ink-5:    #2a2a34;
  --ink-6:    #36363f;
  --ink-7:    #48484f;

  --gold-1:   #b8941e;
  --gold-2:   #c9a84c;
  --gold-3:   #d4b86a;
  --gold-4:   #e2cc8c;
  --gold-5:   #f0e0b4;

  --text-1:   #f0f0ee;
  --text-2:   #c8c8c4;
  --text-3:   #8a8a84;
  --text-4:   #5a5a56;

  --success:  #1a9c5b;
  --danger:   #c0392b;

  --s2: 0 2px 12px rgba(0,0,0,.45);
  --s3: 0 6px 28px rgba(0,0,0,.55);
  --s4: 0 12px 48px rgba(0,0,0,.65);
  --s-gold: 0 0 0 1px rgba(201,168,76,.18), 0 4px 20px rgba(0,0,0,.5);
}

body {
  font-family: 'Nunito Sans', system-ui, sans-serif;
  background: var(--ink-2);
  background-image:
    radial-gradient(ellipse 80% 40% at 50% 0%, rgba(201,168,76,0.07) 0%, transparent 65%),
    radial-gradient(ellipse 40% 30% at 90% 100%, rgba(184,148,30,0.04) 0%, transparent 60%);
  padding: 20px 10px;
  min-height: 100vh;
  color: var(--text-2);
  -webkit-font-smoothing: antialiased;
}

img {
  max-width: 100%;
  height: auto;
  display: block;
}

/* ===== HEADER BAR ===== */
.header-bar {
  width: 100%;
  max-width: 1400px;
  margin: 0 auto 30px;
  background: var(--ink-1);
  border-radius: 16px;
  padding: 15px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: var(--s3);
  border: 1px solid var(--ink-5);
  position: relative;
  overflow: hidden;
}

/* Gold bottom accent line */
.header-bar::after {
  content: '';
  position: absolute;
  bottom: 0; left: 5%; right: 5%; height: 1px;
  background: linear-gradient(90deg, transparent, var(--gold-1) 30%, var(--gold-4) 50%, var(--gold-1) 70%, transparent);
  opacity: 0.55;
}

.header-bar img {
  height: 50px;
  max-width: 120px;
  object-fit: contain;
  filter: drop-shadow(0 0 8px rgba(201,168,76,0.25));
  transition: transform 0.3s ease;
}

.header-bar img:hover {
  transform: scale(1.05);
}

.center-section h1 {
  margin: 0;
  font-size: clamp(20px, 4vw, 30px);
  font-weight: 900;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: var(--gold-3);
}

.right-section p {
  margin: 0;
  font-size: clamp(12px, 2.5vw, 14px);
  color: var(--text-3);
  font-weight: 600;
}

/* ===== ORDERS WRAPPER ===== */
.orders-wrapper {
  width: 100%;
  max-width: 1400px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 0;
}

/* ===== ORDER CARD ===== */
.order-card {
  width: 100%;
  background: var(--ink-3);
  border: 1px solid var(--ink-5);
  padding: 25px 20px;
  display: flex;
  flex-direction: column;
  gap: 20px;
  position: relative;
  margin-bottom: 40px;
  border-radius: 16px;
  border-left: 4px solid var(--ink-6);
  box-shadow: var(--s2);
  transition: box-shadow 0.3s ease, border-color 0.3s ease;
}

.order-card:hover {
  box-shadow: var(--s-gold);
}

/* Order separator */
.order-card::after {
  content: '';
  position: absolute;
  bottom: -22px;
  left: 50%;
  transform: translateX(-50%);
  width: 70%;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--gold-1), transparent);
  opacity: 0.2;
}

.order-card:last-child::after {
  display: none;
}

/* Status-based left border */
.order-card:has(.placed-status),
.order-card:has(.packed-text) {
  border-left-color: var(--gold-2);
}

.order-card:has(.delivered-status),
.order-card:has(.delivered-text) {
  border-left-color: var(--success);
}

.order-card:has(.cancelled-status),
.order-card:has(.cancelled-text) {
  border-left-color: var(--danger);
}

/* ===== ORDER DETAILS ===== */
.order-details {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 18px;
}

/* ===== STATUS BADGE ===== */
.status {
  padding: 8px 20px;
  border-radius: 50px;
  font-weight: 800;
  font-size: clamp(11px, 2.5vw, 13px);
  display: inline-block;
  width: fit-content;
  max-width: 100%;
  text-transform: uppercase;
  letter-spacing: 1px;
  box-shadow: var(--s2);
  transition: all 0.3s ease;
}

.placed-status {
  background: rgba(201,168,76,0.12);
  color: var(--gold-3);
  border: 1.5px solid var(--gold-2);
}

.delivered-status {
  background: rgba(26,156,91,0.12);
  color: #4ade80;
  border: 1.5px solid var(--success);
}

.cancelled-status {
  background: rgba(192,57,43,0.12);
  color: #f87171;
  border: 1.5px solid var(--danger);
}

/* ===== ORDER HEADER INFO ===== */
.order-header {
  width: 100%;
  background: var(--ink-4);
  padding: 15px 18px;
  border-radius: 12px;
  border: 1px solid var(--ink-6);
}

.order-header p {
  margin: 6px 0;
  font-size: clamp(12px, 2.8vw, 14px);
  color: var(--text-2);
  line-height: 1.7;
  word-wrap: break-word;
}

.order-header strong {
  color: var(--text-3);
  font-weight: 700;
  display: inline-block;
  min-width: 110px;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.8px;
}

/* ===== TIMELINE ===== */
.timeline {
  width: 100%;
  display: flex;
  justify-content: space-between;
  position: relative;
  margin: 10px 0;
  padding: 0 5px;
}

.timeline::before {
  content: '';
  position: absolute;
  top: 9px;
  left: 12%;
  right: 12%;
  height: 2px;
  background: var(--ink-6);
  border-radius: 10px;
}

.timeline-step {
  flex: 1;
  text-align: center;
  position: relative;
  z-index: 2;
  min-width: 0;
}

.circle {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: var(--ink-6);
  margin: 0 auto;
  transition: all 0.3s ease;
  border: 2px solid var(--ink-5);
  box-shadow: 0 2px 6px rgba(0,0,0,0.3);
}

.circle.active {
  background: linear-gradient(135deg, var(--gold-1), var(--gold-3));
  border-color: var(--gold-2);
  box-shadow: 0 0 0 4px rgba(201,168,76,0.2), 0 2px 8px rgba(201,168,76,0.35);
  transform: scale(1.15);
}

.timeline-step span {
  display: block;
  margin-top: 8px;
  font-size: clamp(9px, 2.2vw, 12px);
  font-weight: 800;
  color: var(--text-4);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  word-break: break-word;
  padding: 0 2px;
}

.timeline-step:has(.active) span {
  color: var(--gold-3);
}

/* ===== PRODUCT IMAGE ===== */
.large-product-image {
  width: 100%;
  height: auto;
  aspect-ratio: 1 / 1;
  max-height: 300px;
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid var(--ink-6);
  background: var(--ink-4);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--s2);
  transition: all 0.3s ease;
  margin-bottom: 15px;
}

.large-product-image:hover {
  transform: scale(1.01);
  box-shadow: var(--s-gold);
  border-color: var(--gold-1);
}

.large-product-image img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  padding: 10px;
  transition: transform 0.3s ease;
}

.large-product-image:hover img {
  transform: scale(1.03);
}

/* ===== ITEM BOX ===== */
.item-box {
  width: 100%;
  background: var(--ink-4);
  border-radius: 14px;
  padding: 20px 18px;
  border: 1px solid var(--ink-6);
  margin-bottom: 12px;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
  box-shadow: var(--s2);
}

.item-box::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 3px; height: 100%;
  background: linear-gradient(180deg, var(--gold-1), var(--gold-3));
  opacity: 0;
  transition: opacity 0.3s ease;
}

.item-box:hover::before {
  opacity: 1;
}

.item-box:hover {
  transform: translateY(-2px);
  box-shadow: var(--s-gold);
  border-color: var(--gold-1);
}

.item-box p {
  margin: 8px 0;
  font-size: clamp(13px, 2.8vw, 14px);
  color: var(--text-2);
  line-height: 1.7;
  word-wrap: break-word;
  display: flex;
  align-items: baseline;
  gap: 6px;
}

.item-box p strong {
  color: var(--text-3);
  font-weight: 700;
  min-width: 100px;
  flex-shrink: 0;
  font-size: clamp(10px, 2.2vw, 12px);
  text-transform: uppercase;
  letter-spacing: 0.8px;
}

/* ===== ITEM IMAGE ===== */
.item-image {
  width: 100%;
  max-width: 500px;
  margin: 0 auto 16px;
  cursor: pointer;
  border-radius: 12px;
  overflow: hidden;
  transition: all 0.3s ease;
  background: var(--ink-3);
  border: 1px solid var(--ink-6);
  box-shadow: var(--s2);
}

.item-image:hover {
  transform: translateY(-3px);
  box-shadow: var(--s-gold);
  border-color: var(--gold-1);
}

.item-image img {
  width: 100%;
  height: auto;
  max-height: 180px;
  object-fit: contain;
  transition: all 0.3s ease;
  padding: 16px;
  display: block;
  margin: 0 auto;
}

.item-image:hover img {
  transform: scale(1.03);
}

@media (max-width: 768px) {
  .item-image { max-width: 100%; }
  .item-image img { max-height: 160px; padding: 12px; }
}

@media (max-width: 480px) {
  .item-image img { max-height: 140px; padding: 10px; }
}

/* ===== BUTTONS & STATUS TEXT ===== */
.cancel-btn {
  width: 100%;
  margin-top: 12px;
  padding: 13px 24px;
  border: none;
  border-radius: 10px;
  background: rgba(192,57,43,0.15);
  color: #f87171;
  border: 1.5px solid var(--danger);
  font-weight: 800;
  font-family: 'Nunito Sans', system-ui;
  font-size: clamp(13px, 3vw, 15px);
  cursor: pointer;
  transition: all 0.3s ease;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.cancel-btn:hover {
  background: rgba(192,57,43,0.25);
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(192,57,43,0.3);
}

.cancel-btn:active {
  transform: translateY(0);
}

.delivered-text,
.cancelled-text,
.packed-text {
  width: 100%;
  margin-top: 12px;
  font-size: clamp(13px, 3vw, 15px);
  font-weight: 800;
  padding: 11px 20px;
  border-radius: 10px;
  display: block;
  text-align: center;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.delivered-text {
  color: #4ade80;
  background: rgba(26,156,91,0.1);
  border: 1.5px solid var(--success);
}

.cancelled-text {
  color: #f87171;
  background: rgba(192,57,43,0.1);
  border: 1.5px solid var(--danger);
}

.packed-text {
  color: var(--gold-3);
  background: rgba(201,168,76,0.1);
  border: 1.5px solid var(--gold-2);
}

/* ===== POPUP STYLES ===== */
#confirmPopup,
#successPopup {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.75);
  backdrop-filter: blur(6px);
  z-index: 1000;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.3s ease;
  padding: 20px;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

.popup-content {
  width: 100%;
  max-width: 400px;
  background: var(--ink-3);
  border: 1px solid var(--ink-5);
  padding: 30px;
  border-radius: 20px;
  box-shadow: var(--s4), var(--s-gold);
  text-align: center;
  animation: slideUp 0.3s ease;
  position: relative;
  overflow: hidden;
}

.popup-content::before {
  content: '';
  position: absolute;
  top: 0; left: 10%; right: 10%; height: 1px;
  background: linear-gradient(90deg, transparent, var(--gold-2), transparent);
  opacity: 0.5;
}

@keyframes slideUp {
  from { transform: translateY(30px); opacity: 0; }
  to   { transform: translateY(0); opacity: 1; }
}

.popup-content h3 {
  font-size: clamp(16px, 4vw, 20px);
  font-weight: 900;
  margin-bottom: 10px;
  color: var(--text-1);
}

.popup-content p {
  font-size: clamp(13px, 3vw, 14px);
  color: var(--text-3);
  margin-bottom: 22px;
  line-height: 1.6;
}

.popup-buttons {
  display: flex;
  gap: 10px;
  justify-content: center;
  flex-wrap: wrap;
}

.yes-btn,
.no-btn {
  flex: 1;
  min-width: 100px;
  padding: 11px 22px;
  border: none;
  border-radius: 10px;
  font-weight: 800;
  font-family: 'Nunito Sans', system-ui;
  font-size: clamp(12px, 3vw, 14px);
  cursor: pointer;
  transition: all 0.3s ease;
  text-transform: uppercase;
  letter-spacing: 0.8px;
}

.yes-btn {
  background: rgba(192,57,43,0.15);
  color: #f87171;
  border: 1.5px solid var(--danger);
}

.yes-btn:hover {
  background: rgba(192,57,43,0.28);
  transform: translateY(-2px);
  box-shadow: 0 6px 18px rgba(192,57,43,0.3);
}

.no-btn {
  background: linear-gradient(135deg, var(--gold-1), var(--gold-2));
  color: var(--ink-0);
  border: none;
  box-shadow: 0 4px 12px rgba(184,148,30,0.3);
}

.no-btn:hover {
  background: linear-gradient(135deg, var(--gold-2), var(--gold-4));
  transform: translateY(-2px);
  box-shadow: 0 6px 18px rgba(201,168,76,0.4);
}

/* ===== NO ORDERS MESSAGE ===== */
.no-orders-message,
.orders-wrapper > p {
  text-align: center;
  font-size: clamp(16px, 4vw, 18px);
  color: var(--text-3);
  padding: 50px 20px;
  background: var(--ink-3);
  border: 1px solid var(--ink-5);
  border-radius: 16px;
  box-shadow: var(--s2);
  margin: 30px auto;
  max-width: 600px;
  font-weight: 700;
}

/* ===== SELECTION ===== */
::selection { background: var(--gold-2); color: var(--ink-0); }
::-moz-selection { background: var(--gold-2); color: var(--ink-0); }

/* ============================================
   RESPONSIVE BREAKPOINTS
============================================ */

@media (min-width: 1400px) {
  .order-card {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 40px;
    padding: 35px 40px;
  }
  .large-product-image { height: 320px; max-height: none; }
  .status { padding: 10px 24px; font-size: 13px; }
}

@media (min-width: 1024px) and (max-width: 1399px) {
  .order-card {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 35px;
    padding: 30px 35px;
  }
  .large-product-image { height: 280px; max-height: none; }
}

@media (min-width: 768px) and (max-width: 1023px) {
  body { padding: 20px 12px; }
  .header-bar { padding: 16px 22px; }
  .order-card {
    display: grid;
    grid-template-columns: 1fr 240px;
    gap: 30px;
    padding: 28px 30px;
  }
  .large-product-image { height: 240px; max-height: none; }
}

@media (min-width: 481px) and (max-width: 767px) {
  body { padding: 18px 12px; }
  .header-bar {
    flex-direction: column;
    gap: 10px;
    text-align: center;
    padding: 14px 18px;
  }
  .header-bar img { height: 45px; }
  .order-card { padding: 22px 18px; }
  .large-product-image { max-height: 280px; }
  .timeline::before { left: 10%; right: 10%; }
}

@media (min-width: 361px) and (max-width: 480px) {
  body { padding: 15px 10px; }
  .header-bar {
    flex-direction: column;
    gap: 10px;
    text-align: center;
    padding: 12px 15px;
  }
  .header-bar img { height: 42px; }
  .right-section { display: none; }
  .order-card { padding: 20px 15px; }
  .large-product-image { max-height: 240px; }
  .timeline::before { left: 8%; right: 8%; }
  .circle { width: 16px; height: 16px; }
}

@media (max-width: 360px) {
  body { padding: 12px 8px; }
  .header-bar {
    flex-direction: column;
    gap: 8px;
    text-align: center;
    padding: 10px 12px;
    border-radius: 12px;
  }
  .header-bar img { height: 38px; }
  .right-section { display: none; }
  .order-card { padding: 18px 12px; border-left-width: 3px; }
  .large-product-image { max-height: 220px; border-radius: 10px; }
  .status { padding: 7px 16px; }
  .order-header { padding: 12px 14px; }
  .timeline { padding: 0 3px; }
  .timeline::before { left: 6%; right: 6%; top: 8px; height: 2px; }
  .circle { width: 14px; height: 14px; }
  .item-box { padding: 10px 12px; }
  .popup-buttons { flex-direction: column; }
  .yes-btn, .no-btn { width: 100%; }
}

@media (max-width: 320px) {
  body { padding: 10px 6px; }
  .header-bar img { height: 35px; }
  .order-card { padding: 15px 10px; }
  .large-product-image { max-height: 200px; }
  .timeline::before { left: 5%; right: 5%; }
}
</style>
</head>

<body>

<!-- HEADER BAR -->
<div class="header-bar">
  <div class="left-section">
    <a href="/" style="display:flex;align-items:center;text-decoration:none;">
      <img src="/images/logo.png" alt="AKC AUTO PARTS" style="cursor:pointer;">
    </a>
  </div>

  <div class="center-section">
    <h1><%= t.myOrders %></h1>
  </div>

  <div class="right-section">
    <p><%= t.partsFor %></p>
  </div>
</div>

<!-- ORDERS CONTAINER -->
<div class="orders-wrapper">

  <% if (!orders || orders.length === 0) { %>
    <p><%= t.noOrders %></p>
  <% } %>

  <% orders.forEach(function(order){ %>

    <%
      const orderDate = new Date(order.createdAt);
      const now = new Date();
      const diffDays = Math.floor((now - orderDate) / (1000 * 60 * 60 * 24));
      const deliveryDate = new Date(orderDate);
      deliveryDate.setDate(deliveryDate.getDate() + 6);
    %>

    <!-- ORDER CARD -->
    <div class="order-card">

      <!-- DETAILS -->
      <div class="order-details">

        <!-- STATUS BADGE -->
        <% if (order.status === "Pending") { %>
          <span class="status placed-status">Pending</span>
        <% } else if (order.status === "Packed") { %>
          <span class="status placed-status">Packed</span>
        <% } else if (order.status === "Delivered") { %>
          <span class="status delivered-status">Delivered</span>
        <% } else if (order.status === "Cancelled") { %>
          <span class="status cancelled-status">Cancelled</span>
        <% } %>

        <!-- HEADER -->
        <div class="order-header">
          <p><strong><%= t.orderDate %>:</strong> <%= orderDate.toDateString() %></p>
          <p><strong><%= t.totalPrice %>:</strong> ₹<%= order.totalPrice %></p>
          <p><strong><%= t.deliveryDate %>:</strong> <%= deliveryDate.toDateString() %></p>
        </div>

        <!-- TIMELINE -->
        <div class="timeline">
          <div class="timeline-step">
            <div class="circle active"></div>
            <span>Placed</span>
          </div>
          <div class="timeline-step">
            <div class="circle <%= (order.status === 'Packed' || order.status === 'Delivered') ? 'active' : '' %>"></div>
            <span>Packed</span>
          </div>
          <div class="timeline-step">
            <div class="circle <%= order.status === 'Delivered' ? 'active' : '' %>"></div>
            <span>Delivered</span>
          </div>
        </div>

        <!-- ITEMS -->
        <%
          let items = order.items;
          if (typeof items === "string") { items = JSON.parse(items); }
        %>
        <% if (items && items.length > 0) { %>
          <% items.forEach(function(item){ %>
            <div class="item-box">
              <div class="item-image" onclick="window.location.href='/product?id=<%= item.id %>'">
                <img src="<%= item.img %>" alt="<%= item.name %>">
              </div>
              <p><strong>Name:</strong> <%= item.name %></p>
              <p><strong>Product ID:</strong> <%= item.id %></p>
              <p><strong>Price:</strong> ₹<%= item.price %></p>
              <p><strong>Quantity:</strong> <%= item.qty %></p>
            </div>
          <% }) %>
        <% } %>

        <!-- ACTION -->
        <% if (order.status === "Pending") { %>
          <button class="cancel-btn" onclick="cancelOrder('<%= order.id %>')">Cancel Order</button>
        <% } else if (order.status === "Packed") { %>
          <p class="packed-text">Order Packed 📦</p>
        <% } else if (order.status === "Delivered") { %>
          <p class="delivered-text">Order Delivered ✔</p>
        <% } else if (order.status === "Cancelled") { %>
          <p class="cancelled-text">Order Cancelled ✖</p>
        <% } %>

      </div>

    </div>
    <!-- END ORDER CARD -->

  <% }) %>

</div>


<!-- CONFIRM CANCEL POPUP -->
<div id="confirmPopup">
  <div class="popup-content">
    <h3><%= t.confirmCancel %></h3>
    <p><%= t.areYouSure %></p>
    <div class="popup-buttons">
      <button class="yes-btn" onclick="confirmCancel()"><%= t.yes %></button>
      <button class="no-btn" onclick="closeConfirm()"><%= t.no %></button>
    </div>
  </div>
</div>

<!-- SUCCESS POPUP -->
<div id="successPopup">
  <div class="popup-content">
    <h3><%= t.orderCancelled %></h3>
    <p><%= t.orderCancelledSuccess %></p>
  </div>
</div>

<script>
let currentOrderId = null;

function cancelOrder(orderId) {
  currentOrderId = orderId;
  document.getElementById("confirmPopup").style.display = "flex";
}

function closeConfirm() {
  document.getElementById("confirmPopup").style.display = "none";
}

function confirmCancel() {
  document.getElementById("confirmPopup").style.display = "none";

  fetch(`/cancel-order/${currentOrderId}`, { method: "POST" })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        document.getElementById("successPopup").style.display = "flex";
        setTimeout(() => {
          document.getElementById("successPopup").style.display = "none";
          location.reload();
        }, 1500);
      }
    });
}
</script>

</body>
</html>
