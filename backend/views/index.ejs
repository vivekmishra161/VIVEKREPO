  .controls .search input, #liveSearch { width: 100%; }
  select.select, select.sort, #manufacturerSelect, #categorySelect, #sortSelect {
    width: 100%; flex: 1 1 100%; min-width: 0;
  }
  .grid, #productGrid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
  .card { padding: 10px; border-radius: 14px; }
  .card img, .card .product-img { height: 130px; }
  .title { font-size: 12.5px; }
  .price { font-size: 15px; }
  .footer { padding: 40px 14px 0; margin-top: 50px; }
  .footer-container { grid-template-columns: 1fr; gap: 26px; }
  .header-cart-btn .cart-text { display: none; }
  .header-cart-btn { padding: 10px 14px; }
}

/* ═══════════════════════════════════
