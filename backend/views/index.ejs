@media (max-width: 480px) {
  .topbar, .mobile-header { height: 56px; padding: 0 12px; }
  .header-logo { height: 30px; }
  .header-title { font-size: 15px; }
  .header-sub { font-size: 9px; }
  .why-us-header { padding: 24px 12px 4px; }
  .why-us-header h2 { font-size: 22px; }
  .why-us-section { grid-template-columns: 1fr 1fr; gap: 10px; padding: 0 10px; }
