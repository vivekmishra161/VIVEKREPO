  .sidebar-brand h3 { font-size: 14px; }
  .mobile-sidebar-content { padding: 14px 14px 22px; gap: 12px; }
  .sidebar-menu a { padding: 11px 14px; font-size: 13px; }
  .footer { padding: 32px 12px 0; margin-top: 36px; }
