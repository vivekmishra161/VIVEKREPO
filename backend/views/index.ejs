<script>
const products = <%- JSON.stringify(products || []) %>;
/* ------------ Cart LocalStorage ------------ */
const LS_CART_KEY = 'akc_cart_v1';

function loadCart(){ try{ return JSON.parse(localStorage.getItem(LS_CART_KEY)) || []; }catch(e){return []} }
function saveCart(c){ localStorage.setItem(LS_CART_KEY, JSON.stringify(c)); updateCartBadge(); }

function updateCartBadge(){
  const cart = loadCart();
  const count = cart.reduce((s,i)=>s + (i.qty||0), 0);
  
  // Update the header cart badge (id="headerCartBadge")
  const el = document.getElementById('headerCartBadge');
  if(el) {
    if(count > 0) { 
      el.style.display = 'flex'; 
      el.textContent = count;
      
      // Optional: Add bounce animation
      el.classList.add('badge-bounce');
      setTimeout(() => {
        el.classList.remove('badge-bounce');
      }, 300);
    } else { 
      el.style.display = 'none'; 
    }
  }
}

/* ------------ Messages ------------ */
function showMessage(message, type = 'success'){
  const bar = document.getElementById('messageBar');
  if(!bar) return;
  bar.textContent = message;
  bar.classList.remove('success','error');
  bar.classList.add(type === 'error' ? 'error' : 'success');

  clearTimeout(window._msgTimer);
  window._msgTimer = setTimeout(()=>{
    bar.classList.remove('success','error');
    bar.style.display = 'none';
  }, 4000);

  bar.style.display = 'block';
}

/* ------------ Render products ------------ */
const productGrid = document.getElementById('productGrid');
const resultsCount = document.getElementById('resultsCount');

function renderProducts(list) {
  // ALWAYS show grid again
  productGrid.style.display = "grid";

  productGrid.innerHTML = '';

  if (!list || list.length === 0) {
    productGrid.innerHTML = `
      <div style="grid-column:1/-1; padding:18px; background:#fff; border-radius:10px">
        No products found
      </div>
    `;
    resultsCount.textContent = 'Showing 0 products';
    return;
  }

  list.forEach(p => {
    const div = document.createElement('div');
    div.className = 'card';

    const imageSrc =
     p.image ||
     p.img ||
     `/images/categories/${String(p.category).toLowerCase()}.jpg`;


div.innerHTML = `
    <img class="product-img"
       src="${imageSrc}"
       alt="${escapeHtml(p.name)}"
       loading="lazy"
       onclick="viewPart('${p.id}')"
       style="cursor: pointer;">
        <div>
          <p class="title">${escapeHtml(p.name)}</p>
          <div class="id">${p.id} • <span class="muted">${p.manufacturer}</span></div>
        </div>
        <div class="price">₹${formatPrice(p.finalPrice ?? p.price)}</div>
      </div>

      <div style="display:flex; gap:8px; align-items:center; margin-top:8px;">
        <button class="btn secondary" onclick="viewPart('${p.id}')">View</button>
      </div>
    `;

    productGrid.appendChild(div);
  });

  resultsCount.textContent = `Showing ${list.length} products`;
}

/* ------------ Filters ------------ */
async function loadProducts(filters = {}) {
  const params = new URLSearchParams(filters).toString();

  const res = await fetch(`/api/products?${params}`);
  const data = await res.json();

  renderProducts(data);
}
function formatPrice(value) {
  return Number(value).toLocaleString("en-IN", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2
  });
}

function filterByCategory(category) {
  loadProducts({ category });
}
function selectCategory(category) {
  document.getElementById("categoryLabel").innerText =
    category || "All Categories";

  document.getElementById("categoryDropdown")
    .classList.remove("active");

  loadProducts({ category });
}
document.querySelectorAll(".filter-btn").forEach(btn => {
  btn.addEventListener("click", () => {
    btn.parentElement.classList.toggle("active");
  });
});

/* ------------ Cart ------------ */
function addToCart(productId, qty){
  const cart = loadCart();
  const existing = cart.find(i => i.id === productId);
  if(existing) existing.qty += qty;
  else cart.push({ id: productId, qty });
  saveCart(cart);
  showMessage('Item added to cart.', 'success');
}
function addToCartFromBtn(btn){
  const card = btn.closest('.card');
  const id = btn.getAttribute('data-id');
  const qty = Number(card.querySelector('.qty').value || 1);
  addToCart(id, qty);
}



/* ------------ Product View (new page) ------------ */
function viewPart(id){
  window.location.href = '/product?id=' + encodeURIComponent(id);
}

/* ------------ UI helpers & init ------------ */
function escapeHtml(str){ return String(str).replace(/[&<>"']/g, (m)=>({ "&":"&amp;", "<":"&lt;", ">":"&gt;", '"':"&quot;", "'":"&#39;" }[m])); }
function numberWithCommas(x){ return x.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ","); }

document.addEventListener('DOMContentLoaded', ()=>{
  renderProducts(products.length ? products : defaultProducts);
  updateCartBadge();
  const maxPrice = Math.max(...products.map(p=>p.price));
  document.getElementById('priceMax').value = maxPrice + 500;
});

document.addEventListener('keydown', (e)=>{
  if(e.key === '/' && document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'TEXTAREA'){
    e.preventDefault(); document.getElementById('miniSearch').focus();
  }
});
</script>
<script>
let currentPromo = 0;
const slides = document.querySelectorAll(".promo-slide");
const dots = document.querySelectorAll(".promo-dot");

function showPromo(index) {
  slides.forEach(s => s.classList.remove("active"));
  dots.forEach(d => d.classList.remove("active"));

  slides[index].classList.add("active");
  dots[index].classList.add("active");
}

// Auto-slide every 5 seconds
setInterval(() => {
  currentPromo = (currentPromo + 1) % slides.length;
  showPromo(currentPromo);
}, 5000);

// Clickable dots
dots.forEach((dot, i) => {
  dot.addEventListener("click", () => {
    currentPromo = i;
    showPromo(i);
  });
});

</script>
