  .promo-slider { height: 170px; border-radius: 12px; margin-bottom: 14px; }
  .controls { flex-direction: column; padding: 10px; gap: 8px; }
  .controls > div { width: 100%; flex-wrap: wrap; gap: 8px; }
  .controls .search { flex: 1 1 100%; min-width: 100%; max-width: 100%; }
  .controls .search input, #liveSearch { width: 100%; height: 36px; font-size: 13px; }
  .chip, #resultsCount { font-size: 11px; padding: 5px 10px; height: 34px; }
  select.select, select.sort, #manufacturerSelect, #categorySelect, #sortSelect {
    width: 100%; flex: 1 1 100%; min-width: 0; height: 36px; font-size: 13px;
  }
  .grid, #productGrid { grid-template-columns: repeat(2, 1fr); gap: 8px; }
  .card { padding: 8px; border-radius: 12px; gap: 8px; }
  .card img, .card .product-img { height: 110px; border-radius: 10px; }
  .title { font-size: 12px; }
  .id { font-size: 10px; }
  .price { font-size: 14px; }
  .card .actions { flex-direction: column; gap: 6px; }
  .card .btn { width: 100%; padding: 8px; font-size: 12px; }
  .qty { width: 100%; }
  .popup-box { padding: 24px 20px; }
  .popup-box h3 { font-size: 18px; }
  .popup-actions { flex-direction: column; gap: 8px; }
  .popup-btn { width: 100%; }
